{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "roles-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/users/roles" },
        "Order": 1
      },
      "core-user-assignments-route": {
        "ClusterId": "core-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/users/{userId}/unit-assignments" },
        "Order": 1
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Order": 2
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "preferences-route": {
        "ClusterId": "notifications-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/preferences/{**catch-all}" }
      },
      "chat-route": {
        "ClusterId": "ai-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "core-route": {
        "ClusterId": "core-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Match": { "Path": "/api/{**catch-all}" },
        "Order": 100
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "destination1": { "Address": "http://identity-api:8080" } }
      },
      "core-cluster": {
        "Destinations": { "destination1": { "Address": "http://core-api:8080" } }
      },
      "notifications-cluster": {
        "Destinations": { "destination1": { "Address": "http://notifications-api:8000" } }
      },
      "ai-cluster": {
        "Destinations": { "destination1": { "Address": "http://compensa-ai:8000" } }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
